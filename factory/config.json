{
  "concurrency": 3,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "checks_timeout_sec": 1800,
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "reviewers": {
    "code":     { "when": ["always"], "model": { "low": "haiku", "medium": "sonnet", "high": "sonnet" } },
    "security": { "when": ["surface:security", "risk:high"], "model": "opus" },
    "ux":       { "when": ["surface:ui"], "model": "sonnet" },
    "ui":       { "when": ["surface:ui"], "model": "sonnet" }
  },
  "protected_paths": [
    "factory/",
    ".claude/"
  ],
  "ports": { "base": 5100, "step": 10, "offsets": { "builder": 0, "ux": 1, "ui": 2 } },
  "prices_usd_per_mtok": {
    "_note": "API list prices per million tokens, matched by model family. Checked 2026-11-19; update when prices change.",
    "fable":  { "input": 8.0, "output": 40.0, "cache_write_5m": 10.0,  "cache_write_1h": 16.0, "cache_read": 0.20 },
    "opus":   { "input": 4.0, "output": 20.0, "cache_write_5m": 5.0,   "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "sonnet": { "input": 2.0, "output": 10.0, "cache_write_5m": 2.5,   "cache_write_1h": 4.0,  "cache_read": 0.10 },
    "haiku":  { "input": 0.1, "output": 0.5,  "cache_write_5m": 0.125, "cache_write_1h": 0.2,  "cache_read": 0.01 }
  }
}
